{
  "name": "C_Allocator",
  "version": "2.1.0",
  "description": "Fixed block memory allocator in C: static pools, no heap, deterministic. fb_allocator for one block size, x_allocator for malloc/free style use across several sizes. RTOS locks for FreeRTOS, ThreadX, Zephyr and CMSIS-RTOS2.",
  "keywords": [
    "allocator",
    "memory",
    "memory pool",
    "fixed block",
    "static pool",
    "malloc",
    "embedded",
    "c",
    "rtos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endurodave/C_Allocator.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/endurodave/C_Allocator",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "C_Allocator.h",
    "fb_allocator.h",
    "x_allocator.h"
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "main.cpp",
      "CMakeLists.txt",
      "LICENSE",
      "README.md",
      "library.json",
      "library.properties"
    ],
    "exclude": [
      "**/.pio",
      "**/.pio/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "examples": [
    {
      "name": "c-allocator-demo",
      "base": "examples/platformio/c-allocator-demo",
      "files": [
        "platformio.ini",
        "freertos_path.py",
        "src/main.cpp"
      ]
    },
    {
      "name": "C_Allocator_Demo",
      "base": "examples/C_Allocator_Demo",
      "files": [
        "C_Allocator_Demo.ino"
      ]
    }
  ]
}
